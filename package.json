    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=22.6"
  }
}
